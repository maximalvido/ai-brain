# Local development configuration
POSTGRES_DB=ai_brain
POSTGRES_USER=ai_brain
POSTGRES_PASSWORD=ai_brain_local
POSTGRES_PORT=55432

# Used by the Rust database adapter and smoke test.
DATABASE_URL=postgres://ai_brain:ai_brain_local@localhost:55432/ai_brain

# Linear personal API key for the read-only connector.
LINEAR_API_KEY=

# Required by the HTTP and stdio MCP services.
BRAIN_API_KEY=replace-with-a-long-random-secret
BRAIN_HTTP_ADDR=127.0.0.1:8787

# Optional Compose overrides.
# BRAIN_HTTP_BIND=127.0.0.1
# BRAIN_HTTP_PORT=8787
# POSTGRES_PORT=55432
